#!/bin/bash

# barkeep — summon the Barkeep overlay in the running Omarchy shell.
#
#   barkeep                    toggle the overlay (default)
#   barkeep show               open it
#   barkeep hide               close it
#   barkeep profiles           open it on the bar profiles
#   barkeep about              open it on the About page
#   barkeep status             print "open" or "closed"
#   barkeep check              print git update state for every plugin folder (JSON)
#   barkeep profile <command>  list | use <p> | next | prev | save <name> | rename | icon | delete
#   barkeep chip on|off        put the profile switcher on the bar, or take it off
#   barkeep --version          print the version

set -euo pipefail

SELF_ID="ninepointlabs.barkeep"
HERE="$(cd "$(dirname "$(readlink -f "$0")")" && pwd)"

# These work on files, so they do not need the shell to be up.
case "${1:-toggle}" in
  profile)
    shift
    exec "$HERE/barkeep-profiles" "$@"
    ;;
  check) exec "$HERE/barkeep-ops" inspect ;;
  -h | --help | help) sed -n '3,14p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  --version | version)
    echo "barkeep $(jq -r '.version // "unknown"' "$HERE/../manifest.json" 2>/dev/null || echo unknown)"
    exit 0
    ;;
  toggle | show | open | profiles | about | hide | close | status | chip) ;;
  *)
    echo "barkeep: unknown command '$1' (see: barkeep --help)" >&2
    exit 1
    ;;
esac

if ! omarchy-shell shell ping >/dev/null 2>&1; then
  echo "barkeep: omarchy-shell is not running" >&2
  exit 1
fi

case "${1:-toggle}" in
  toggle) omarchy-shell shell toggle "$SELF_ID" '{}' ;;
  show | open) omarchy-shell shell summon "$SELF_ID" '{}' >/dev/null ;;
  profiles) omarchy-shell shell summon "$SELF_ID" '{"view":"profiles"}' >/dev/null ;;
  about) omarchy-shell shell summon "$SELF_ID" '{"about":true}' >/dev/null ;;
  hide | close) omarchy-shell shell hide "$SELF_ID" ;;
  status)
    if [[ $(omarchy-shell shell call "$SELF_ID" isOpen "" 2>/dev/null) == "true" ]]; then
      echo open
    else
      echo closed
    fi
    ;;
  chip)
    case "${2:-}" in
      on) "$HERE/barkeep-ops" mutate chip-on "$SELF_ID" ;;
      off) "$HERE/barkeep-ops" mutate chip-off "$SELF_ID" ;;
      *) echo "barkeep: chip on|off" >&2; exit 1 ;;
    esac
    ;;
esac
